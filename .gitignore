# Minecraft runtime files
.curseclient
# minecraftinstance.json (tracked so CurseForge mod list is saved in Git)
user-prefs.json
options.txt
servers.dat
servers.dat_old
usercache.json
usernamecache.json

# Logs and crash reports
logs/
crash-reports/

# Save files
saves/

# Download cache
downloads/

# User-specific data
screenshots/
resourcepacks/
shaderpacks/
schematics/

# Blueprint scans (user-created)
blueprints/*/scans/

# Mod caches
simply_screens_cache/

# Local/per-world data (overrides defaultconfigs)
local/

# Default configs (tracked so new worlds get modpack defaults)
# defaultconfigs/

tacz_backup/

# Backups
backups/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo

# Flywheel mixin output
.mixin.out/
command_history.txt

# Mod JARs (third-party launcher-managed mods ignored, custom in-house mods tracked)
mods/*
!mods/world-engine*.jar

# Runtime cache
/data/

# Session debug logs
debug/

# Sinytra Connector / Fabric loader log
fabricloader.log

# Sable native physics engine DLLs
.sable/

# Config backup files (auto-generated by mods)
config/*.bak
ponders_watched.json
config/spark/activity.json
