{
	chapter_group.7100000000000001.title: "Inventors Progression"
	chapter.7100000000000010.title: "I - Stone Age"
	chapter.7100000000000020.title: "II - Copper Age"
	chapter.7100000000000030.title: "III - Bronze Age"
	chapter.7100000000000040.title: "IV - Crude Mechanical Age"
	chapter.7100000000000050.title: "V - Iron Infrastructure"
	chapter.7100000000000060.title: "VI - Nether Industry"
	chapter.7100000000000070.title: "VII - End Refinement"

	quest.7100000000000100.title: "Fibres of Survival"
	quest.7100000000000100.quest_desc: ["Break grass and ferns to gather Plant Fibre, then twist three fibres into Crude Cordage in your inventory. Gathering by hand only succeeds sometimes; once you have a primitive knife, cutting plants always recovers their fibre."]
	quest.7100000000000101.title: "The Patient Path — Bone Tools"
	quest.7100000000000101.quest_desc: ["Build a complete set of bound bone tools. They work deliberately, but endure far longer than their flint counterparts."]
	quest.7100000000000159.title: "The Sharp Path — Flint Tools"
	quest.7100000000000159.quest_desc: ["Knock and bind a complete set of flint tools. Their keen edges work quickly and strike hard, but brittle heads wear out fast."]
	quest.7100000000000250.title: "Carry the First Spark"
	quest.7100000000000250.quest_desc: ["Combine flint, Plant Fibre, and Crude Cordage or Rope into a Fire Starter. It can ignite the same targets as flint and steel, but is consumed after one successful use, so carry a spare for an extinguished campfire."]
	quest.7100000000000110.title: "Controlled Fire"
	quest.7100000000000110.quest_desc: ["Use one Fire Starter with three sticks and three burnable logs to build a campfire without coal or charcoal. Its four cooking places provide the settlement's first dependable source of heat, and another Fire Starter can relight it if it is extinguished."]
	quest.7100000000000111.title: "A Place to Work"
	quest.7100000000000111.quest_desc: ["Use flint and cordage to assemble a firm work surface where more demanding crafts can begin."]
	quest.7100000000000112.title: "Fire Without Flame"
	quest.7100000000000112.quest_desc: ["Build a mound from four to sixty-four connected burnable logs and surround every exposed side with earth, leaving one face open. Ignite a log through the opening with a Fire Starter, then seal the opening within one minute. After five minutes the smoke stops; uncover the finished mound to recover roughly three quarters of the wood as charcoal. Opening it early greatly reduces the yield."]
	quest.7100000000000251.title: "Water Before Metal"
	quest.7100000000000251.quest_desc: ["Shape three clay balls into an Unfired Clay Bucket, then fire it on a campfire. This early vessel carries water or Tannin Solution and works directly with a Firstworks Barrel, but it cannot hold lava or other hot fluids."]
	quest.7100000000000252.title: "Bound Light"
	quest.7100000000000252.quest_desc: ["Bind coal or charcoal to a stick with Crude Cordage, String, or Twine to craft four torches. Proper Rope is intentionally unnecessary for this small, inexpensive binding."]
	quest.7100000000000113.title: "A Masonry Furnace"
	quest.7100000000000113.quest_desc: ["After relying on the campfire through the Stone Age, build its capstone furnace from cobblestone corners, structural brick blocks, and finished leather in the center. The masonry chamber finally concentrates heat for faster cooking and smelting."]
	quest.7100000000000114.title: "Copper in the Stone"
	quest.7100000000000114.quest_desc: ["Mine your first Raw Copper and bring Clay from your Stone Age workshops. Copper provides the metal, while clay leads into the refractory materials needed to build and contain your foundry's heat."]
	quest.7100000000000150.title: "Hide and Seek"
	quest.7100000000000150.quest_desc: ["Hunt carefully and recover raw hides. Fresh hide cannot be used as leather until it has been washed, scraped, tanned, and dried."]
	quest.7100000000000151.title: "The First Barrel"
	quest.7100000000000151.quest_desc: [
		"Build a Firstworks Barrel from matching planks and slabs. Use the Clay Bucket to move early water or Tannin Solution, and interact directly to add or remove contents while the barrel is open."
		""
		"Toggle the lid with an empty hand or a rising redstone pulse: valid recipes progress only while sealed, and opening early cancels progress without consuming ingredients."
		""
		"Hoppers and pipes work only while open."
		""
		"JEI lists processes, while Jade shows contents and progress in the world."
	]
	quest.7100000000000240.title: "Wash the Hide"
	quest.7100000000000240.quest_desc: ["Wash one Raw Hide with 250 mB of water for two minutes to produce a Soaked Hide. A water bottle supplies exactly one batch."]
	quest.7100000000000244.title: "Ret the Fibres"
	quest.7100000000000244.quest_desc: ["Ret four Plant Fibre in 250 mB of water for one minute. Retting loosens the fibres so they can be spun evenly instead of twisted into wasteful emergency cordage."]
	quest.7100000000000245.title: "Spin the Thread"
	quest.7100000000000245.quest_desc: ["Craft a durable Hand Spindle from a stick, flint, and either Crude Cordage or Rope. Hold it in your main hand with at least two Retted Fibre in your offhand, then hold use until the batch becomes Twine. Releasing early cancels safely; each completed batch wears the spindle slightly."]
	quest.7100000000000248.title: "Frame the Loom"
	quest.7100000000000248.quest_desc: ["Build a Firstworks Loom from planks and slabs. It forms the sturdy wooden frame needed to weave spun thread into usable textile cloth."]
	quest.7100000000000264.title: "Work the Loom"
	quest.7100000000000264.quest_desc: [
		"Load four Twine or String directly onto the Loom's frame."
		""
		"Use an empty hand sixteen times to work the shuttle as the weave grows, then collect the finished Cloth."
		""
		"Hoppers can load thread and remove output, while an empty-handed Create Deployer can automate the strokes."
	]
	quest.7100000000000249.title: "Rope for Harder Work"
	quest.7100000000000249.quest_desc: ["Combine three Twine into proper Rope. Crude Cordage and Rope are both bindings, but only Rope is strong enough for metal and diamond tool assembly."]
	quest.7100000000000246.title: "Fleece from the Flock"
	quest.7100000000000246.quest_desc: ["Use a Bone or Flint Knife on a shearable sheep to gather exactly one Raw Fleece renewably. This costs eight durability and the sheep must regrow its coat. Hunting yields one or two fleece immediately, while proper Shears later harvest three to five without killing the flock."]
	quest.7100000000000247.title: "Wash the Wool"
	quest.7100000000000247.quest_desc: ["Wash Raw Fleece with water to remove dirt and grease while preserving its color. Four pieces of matching Clean Wool can be packed into a wool block; dye can recolor a batch before or after washing."]
	quest.7100000000000152.title: "Scrape It Clean"
	quest.7100000000000152.quest_desc: ["Use a Bone or Flint Knife to scrape the soaked hide clean and prepare its surface for tanning. Each hide wears the knife by one durability; combat swords no longer substitute for this precision tool."]
	quest.7100000000000153.title: "Tannins from the Forest"
	quest.7100000000000153.quest_desc: ["Strip wood to gather Tree Bark. Each block yields one to three pieces, and four pieces are enough to brew a bucket of preserving tannins."]
	quest.7100000000000241.title: "Brew Tannin Solution"
	quest.7100000000000241.quest_desc: ["Infuse four Tree Bark in 1000 mB of water for five minutes to produce 1000 mB of Tannin Solution, enough to tan four scraped hides."]
	quest.7100000000000154.title: "Vegetable Tanning"
	quest.7100000000000154.quest_desc: ["Preserve each Scraped Hide in 250 mB of Tannin Solution for ten minutes. One full bucket can tan four hides together, producing Tannin-Soaked Hide ready for drying."]
	quest.7100000000000242.title: "Dry, Supple Leather"
	quest.7100000000000242.quest_desc: ["Dry the tanned hides over a campfire to finish them into leather. A furnace also works once your masonry workshop is ready, and mechanical pressing will make this step effortless in a later age."]
	quest.7100000000000253.title: "Tanned Protection"
	quest.7100000000000253.quest_desc: ["Stitch finished leather into a complete suit of protective armor. While a leather cap, tunic, pants, and boots offer modest defense, they provide your first real layer of protection against hostility in the wilderness."]
	quest.7100000000000155.title: "A Safe Night's Rest"
	quest.7100000000000155.quest_desc: ["Complete the textile branch with the Firstworks bed recipe: three Cloth, three matching pieces of Clean Wool, and three planks. This permanent place to sleep provides an optional comfort milestone to set your spawn point and pass the night safely."]
	quest.7100000000000156.title: "Earth and Fire"
	quest.7100000000000156.quest_desc: [
		"Load one clay ball into the Wooden Brick Mold and press it twice with an empty hand. Watch the clay spread farther across the cavity after each press, then collect the shaped unfired brick."
		""
		"Fire it over a campfire and bind fired bricks with Mortar mixed in a Barrel."
		""
		"Hoppers can load clay and remove completed bricks; an empty-handed Create Deployer can automate each press."
	]
	quest.7100000000000157.title: "Storage from Clay"
	quest.7100000000000157.quest_desc: ["Fire a large clay vessel into a storage pot. It remains a useful primitive cache, but the woven basket is the practical general-purpose Stone Age container."]
	quest.7100000000000260.title: "A Precise Edge"
	quest.7100000000000260.quest_desc: ["Bind a flint edge to a stick with primitive cordage to shape your first precision knife. It excels at harvesting plant fibres cleanly, scraping soaked hides, and carefully shearing fleece from sheep."]
	quest.7100000000000261.title: "A Place for Everything"
	quest.7100000000000261.quest_desc: ["Weave Twine around a light stick frame to make a nine-slot Basket. It accepts hoppers, pipes, funnels, and chutes, so it remains valuable later as a compact workshop buffer."]
	quest.7100000000000262.title: "Keep the Harvest"
	quest.7100000000000262.quest_desc: ["Build a Primitive Drying Frame from sticks and Twine, then preserve meat, fish, or berries. The frame is consumed by a batch as its bindings wear out."]
	quest.7100000000000263.title: "Grind It Fine"
	quest.7100000000000263.quest_desc: ["Place the Mortar & Pestle, then right-click it with a material to load it. Use an empty hand to begin grinding; interact again when the process finishes to collect the result. Grind bone into meal, ochre into pigment, and later charcoal into powder."]

	quest.7100000000000102.title: "Refractory Thinking"
	quest.7100000000000102.quest_desc: ["Combine clay and sand into fire clay, a material that survives temperatures ordinary stonework cannot withstand."]
	quest.7100000000000115.title: "Fire-Brick Masonry"
	quest.7100000000000115.quest_desc: ["Bake the fire clay into black fire bricks. You will need enough to surround and contain the foundry's heat."]
	quest.7100000000000103.title: "The First Foundry"
	quest.7100000000000103.quest_desc: ["Assemble a controller, fuel tank, drain and fire-brick shell, then place a tap and casting table by the drain. Consult the Metalworks guide for the complete structure."]
	quest.7100000000000116.title: "Shape From Nothing"
	quest.7100000000000116.quest_desc: ["Create an ingot cast. Pouring molten metal into a precise shape allows it to cool into something you can store and use."]
	quest.7100000000000104.title: "The First Copper Batch"
	quest.7100000000000104.quest_desc: ["Feed raw copper into the foundry and pour sixteen ingots. Your first metal stockpile opens the way to stronger tools and useful vessels."]
	quest.7100000000000105.title: "Cast, Then Assemble"
	quest.7100000000000105.quest_desc: ["Craft Blueprint Paper from four paper and blue dye (or lapis), then arrange three Blueprint Paper and two wooden rods in the shape of a pickaxe on a crafting table to make a Pickaxe Blueprint. Cast or shape a Copper Pickaxe Head, then assemble it with a wooden rod on a crafting table. Your new tool can be repaired and upgraded as you discover better materials."]
	quest.7100000000000117.title: "Copper Utilities"
	quest.7100000000000117.quest_desc: ["Craft a bucket and shears. Carrying fluids and gathering wool will make farming, construction and animal care much easier."]
	quest.7100000000000243.title: "Tannins to Go"
	quest.7100000000000243.quest_desc: ["Use an empty bucket on an open Barrel holding at least 1000 mB of Tannin Solution. The filled bucket carries tannin between Barrels without placing it in the world."]
	quest.7100000000000219.title: "Copper-Bound Storage"
	quest.7100000000000219.quest_desc: ["Work a copper ingot into Fasteners, then use them to reinforce wooden chests and barrels. Chests and barrels hold bulk supplies while Baskets remain the compact automation buffer."]

	quest.7100000000000118.title: "Search for Tin"
	quest.7100000000000118.quest_desc: ["Search the Overworld for tin. It is less common than copper, but the two metals can be combined into a far stronger alloy."]
	quest.7100000000000106.title: "The First Alloy"
	quest.7100000000000106.quest_desc: ["Melt three parts copper with one part tin to create bronze. Keep the mixture balanced or valuable metal will be left unused in the foundry."]
	quest.7100000000000119.title: "A Library of Casts"
	quest.7100000000000119.quest_desc: ["Prepare casts for gears, plates and rods. Once these molds are ready, each new batch of metal can be shaped quickly and consistently."]
	quest.7100000000000120.title: "Heavy Hand Tools"
	quest.7100000000000120.quest_desc: ["Cast and assemble a heavy hammer. Its broad head can clear stone faster when opening rooms, tunnels and foundations."]
	quest.7100000000000121.title: "A Proper Kitchen"
	quest.7100000000000121.quest_desc: ["Build a Cooking Pot and combine your harvests into nourishing meals that keep hunger away during long days in the workshop."]
	quest.7100000000000122.title: "Carry the Workshop"
	quest.7100000000000122.quest_desc: ["Craft a backpack so tools, food and gathered resources no longer compete for every space in your pockets."]
	quest.7100000000000123.title: "Mechanical Material"
	quest.7100000000000123.quest_desc: ["Work bronze nuggets into stone to create andesite alloy, a rugged composite suitable for your first moving machines."]

	quest.7100000000000107.title: "The Crude Drivetrain"
	quest.7100000000000107.quest_desc: ["Craft Crude shafts and cogwheels. These rough components tolerate up to 128 RPM and carry 512 SU before overstressing, so begin with compact machines."]
	quest.7100000000000124.title: "Renewable Rotation"
	quest.7100000000000124.quest_desc: ["Place a Water Wheel in a strong current to produce continuous rotational force without exhausting yourself at a hand crank."]
	quest.7100000000000125.title: "Mechanized Grinding"
	quest.7100000000000125.quest_desc: ["Put rotational power to work in a Millstone and grind grain, minerals and other ingredients continuously."]
	quest.7100000000000126.title: "Mechanized Forming"
	quest.7100000000000126.quest_desc: ["Build a Mechanical Press to flatten ingots into sheets and compact loose materials with the force of your drivetrain."]
	quest.7100000000000127.title: "Mechanized Mixing"
	quest.7100000000000127.quest_desc: ["Suspend a Mechanical Mixer above a Basin to blend powders and prepare recipes without stirring every batch by hand."]
	quest.7100000000000128.title: "Mechanized Woodworking"
	quest.7100000000000128.quest_desc: ["Power a Mechanical Saw to cut timber rapidly. It can process logs at the workshop or become the cutting edge of a mobile tree harvester."]
	quest.7100000000000129.title: "Ore Preparation Line"
	quest.7100000000000129.quest_desc: ["Turn a matched pair of Crushing Wheels against one another. Feed ore between them to prepare it for more efficient melting."]
	quest.7100000000000130.title: "The First Mechanical Farm"
	quest.7100000000000130.quest_desc: ["Mount Mechanical Harvesters on a moving contraption to gather mature crops while leaving the field ready to grow again."]
	quest.7100000000000220.title: "The Mechanical Tannery"
	quest.7100000000000220.quest_desc: [
		"A redstone pulse can seal or open a Firstworks Barrel for simple batch control."
		""
		"For continuous production, wash hides with an Encased Fan, scrape them on a Mechanical Saw, brew tannin in a Basin, then mix and press the hides dry."
		""
		"This line replaces every manual wait with powered processing."
	]
	quest.7100000000000131.title: "Prepare for the Ironworks"
	quest.7100000000000131.quest_desc: ["Stockpile crushed iron, charcoal, and calcite. Iron cannot simply be poured into a cast; it must be cleaned, reduced, and worked while hot."]

	quest.7100000000000160.title: "Wash Away the Stone"
	quest.7100000000000160.quest_desc: ["Wash crushed iron until the loose stone and dirt are carried away, leaving a rich concentrate ready for reduction."]
	quest.7100000000000161.title: "Build the Bloomery Charge"
	quest.7100000000000161.quest_desc: ["Blend iron concentrate with charcoal dust and calcite. Carbon draws oxygen from the ore while the flux gathers unwanted material."]
	quest.7100000000000162.title: "The First Iron Bloom"
	quest.7100000000000162.quest_desc: ["Fire the prepared charge into a spongy iron bloom, then press it while hot to drive out trapped slag and close the metal together."]
	quest.7100000000000163.title: "Iron Under the Hammer"
	quest.7100000000000163.quest_desc: ["Press the worked bloom into a wrought-iron billet. Forge it into three ingots, or remelt the billet into enough iron for a three-ingot tool head. Only properly worked iron can survive this final melting cleanly."]

	quest.7100000000000132.title: "Greater Water Power"
	quest.7100000000000132.quest_desc: ["Build a Large Water Wheel to draw more power from the same river and support several machines from one source."]
	quest.7100000000000133.title: "Power From the Wind"
	quest.7100000000000133.quest_desc: ["Raise sails around a Windmill Bearing and let the open sky power a larger, centralized workshop."]
	quest.7100000000000134.title: "Mining Beyond the Pickaxe"
	quest.7100000000000134.quest_desc: ["Mount Mechanical Drills where stone must be removed continuously. They are ideal for tunnels, quarries and moving excavation rigs."]
	quest.7100000000000135.title: "Moving Contraption Cargo"
	quest.7100000000000135.quest_desc: ["Pair two Portable Storage Interfaces so a returning contraption can unload its cargo without being dismantled."]
	quest.7100000000000136.title: "Bulk Storage"
	quest.7100000000000136.quest_desc: ["Build an Item Vault to hold large buffers directly inside a production line or aboard a moving contraption."]
	quest.7100000000000137.title: "Organized Storage"
	quest.7100000000000137.quest_desc: ["Upgrade a chest with copper to hold more supplies in one place and make room for useful storage upgrades."]
	quest.7100000000000138.title: "Manage the Warehouse"
	quest.7100000000000138.quest_desc: ["Use the Storage Tool to configure your containers and bring order to the materials flowing through the workshop."]
	quest.7100000000000139.title: "The Expedition Stockpile"
	quest.7100000000000139.quest_desc: ["Prepare charcoal, bronze and iron before crossing into the Nether. A well-supplied expedition has a much better chance of returning home."]

	quest.7100000000000200.title: "Beyond Charcoal Heat"
	quest.7100000000000200.quest_desc: ["Enter the Nether, find a fortress and capture a blaze in an empty burner. Its heat can drive reactions no ordinary flame can sustain."]
	quest.7100000000000140.title: "Nether Nickel"
	quest.7100000000000140.quest_desc: ["Search the Nether for nickel deposits and bring a full batch home. This metal is essential for heat-stable machinery."]
	quest.7100000000000201.title: "Stable Under Heat"
	quest.7100000000000201.quest_desc: ["Alloy two parts iron with one part nickel to produce Invar, a stable metal that resists expansion when machinery grows hot."]
	quest.7100000000000202.title: "Precision Alloy"
	quest.7100000000000202.quest_desc: ["Heat copper and zinc together to produce brass. Its fine working properties make precise mechanisms and controlled logistics possible."]
	quest.7100000000000203.title: "The Basic Drivetrain"
	quest.7100000000000203.quest_desc: ["Rebuild the drivetrain with Invar and brass. Basic components tolerate 256 RPM and carry 2048 SU, enough for larger connected factories."]
	quest.7100000000000141.title: "Filtered Logistics"
	quest.7100000000000141.quest_desc: ["Use brass funnels and tunnels to filter, split and distribute items exactly where each production line needs them."]
	quest.7100000000000142.title: "Mechanical Handling"
	quest.7100000000000142.quest_desc: ["Program a Mechanical Arm to move selected items between machines, depots and burners where belts cannot reach cleanly."]
	quest.7100000000000204.title: "Repeatable Precision"
	quest.7100000000000204.quest_desc: ["Build a sequenced assembly line and produce sixteen Precision Mechanisms without assembling each one by hand."]
	quest.7100000000000210.title: "Seal the Coal"
	quest.7100000000000210.quest_desc: ["Pack coal dust into ceramic basins and seal it away from open air. The vessel lets heat drive off smoke and impurities without burning away the carbon."]
	quest.7100000000000211.title: "Fire Without Flame"
	quest.7100000000000211.quest_desc: ["Superheat the sealed charges until dense metallurgical coke remains. This clean carbon can endure the foundry temperatures needed for steelmaking."]

	quest.7100000000000143.title: "Open the Stronghold"
	quest.7100000000000143.quest_desc: ["Prepare enough Eyes of Ender to locate a stronghold and restore its ancient portal."]
	quest.7100000000000144.title: "Master the End"
	quest.7100000000000144.quest_desc: ["Face the Ender Dragon and collect its lingering breath. Beyond the central island, valuable new resources await."]
	quest.7100000000000205.title: "Metal From the End"
	quest.7100000000000205.quest_desc: ["Mine titanium from the End stone, melt the ore in your foundry and cast sixteen bright, resilient ingots."]
	quest.7100000000000212.title: "The Weight Within"
	quest.7100000000000212.quest_desc: ["Return to the Nether for Ancient Debris. Beneath its scorched shell lies a dense tungsten-bearing material that ordinary furnaces cannot separate."]
	quest.7100000000000213.title: "Wash the Heavy Dust"
	quest.7100000000000213.quest_desc: ["Crush Ancient Debris, then wash the dark residue until clean tungsten dust remains. Its extraordinary heat resistance demands the hottest foundry you can build."]
	quest.7100000000000214.title: "The Refractory Metal"
	quest.7100000000000214.quest_desc: ["Melt purified tungsten at the limit of a lava-fired foundry and cast it into dense ingots. This metal will form the backbone of your strongest alloy yet."]
	quest.7100000000000215.title: "Netherite Reforged"
	quest.7100000000000215.quest_desc: ["Alloy two parts tungsten with one part titanium and one part gold. Cast the molten metal into Netherite: resilient enough for the most demanding tools, armour and machines."]
	quest.7100000000000216.title: "A Mesh That Endures"
	quest.7100000000000216.quest_desc: ["Build a rigid mesh from titanium plates and steel rods. It will withstand repeated superheated compression and can be recovered after every batch."]
	quest.7100000000000217.title: "Bind the Charcoal"
	quest.7100000000000217.quest_desc: ["Distil bark in a sealed ceramic vessel to capture wood tar, then blend the tar with charcoal dust. The sticky mixture forms soft green biocoke briquettes."]
	quest.7100000000000218.title: "A Forest-Fed Steelworks"
	quest.7100000000000218.quest_desc: ["Compress green briquettes through the titanium mesh under superheat. Dense biocoke can replace coal coke in the foundry, allowing automated tree farms to sustain steel production."]
	quest.7100000000000145.title: "Carbon Into Iron"
	quest.7100000000000145.quest_desc: ["Melt wrought-iron billets and metallurgical coke in the foundry. Carefully alloy their molten iron and carbon, then cast the resulting steel into ingots."]
	quest.7100000000000146.title: "Titanium Forming"
	quest.7100000000000146.quest_desc: ["Form titanium into plates ready for light, strong machine frames and the harsh conditions beyond the Overworld."]
	quest.7100000000000147.title: "The Steelworks"
	quest.7100000000000147.quest_desc: ["Cast steel gears for machinery that must survive greater forces. With steel and precision mechanisms mastered, you can construct stable Eyes and seek the End portal."]
	quest.7100000000000206.title: "The Refined Drivetrain"
	quest.7100000000000206.quest_desc: ["Combine titanium, steel and Precision Mechanisms with your Basic drivetrain. Refined components reach 512 RPM and carry 8192 SU, providing the power needed for aerospace engineering."]
}
